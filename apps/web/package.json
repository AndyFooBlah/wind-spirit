{
  "name": "@wind-spirit/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5179 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5179",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy": "firebase deploy --only hosting --project wind-spirit-prod"
  },
  "dependencies": {
    "@wind-spirit/agents": "workspace:*",
    "@wind-spirit/gen": "workspace:*",
    "@wind-spirit/harness": "workspace:*",
    "@wind-spirit/sim": "workspace:*",
    "firebase": "^12.0.0",
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.1",
    "vite": "^7.1.0"
  }
}
